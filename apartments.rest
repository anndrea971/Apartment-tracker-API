@baseUrl = http://localhost:3000

### To test against your deployed API instead, comment the line above
### and uncomment this one:
# @baseUrl = https://apartment-tracker-api-4yal.onrender.com

### NOTE ON AUTH: GET /auth/github redirects to GitHub's own login page,
### which only works in a real browser, not from this .rest file. For
### anything protected (POST/PUT/DELETE below), log in via the browser at
### {{baseUrl}}/auth/github first, then use Swagger UI's "Try it out" at
### {{baseUrl}}/api-docs, since the browser sends your session cookie
### automatically there. Requests sent straight from this file will NOT be
### logged in, and protected routes will correctly return 401.

### Check current login status
GET {{baseUrl}}/auth/status

### Get all apartments (public, no login needed)
GET {{baseUrl}}/apartments

### Get a single apartment by id (public)
GET {{baseUrl}}/apartments/REPLACE_WITH_REAL_ID

### Create a new apartment (protected — expect 401 here, test via Swagger instead)
POST {{baseUrl}}/apartments
Content-Type: application/json

{
  "address": "123 Main St, Apt 4B",
  "rent": 1450,
  "bedrooms": 2,
  "bathrooms": 1,
  "squareFootage": 850,
  "petsAllowed": true,
  "contactInfo": "landlord@example.com",
  "status": "interested",
  "notes": "Close to campus, has in-unit laundry"
}

### Create an apartment with missing/invalid fields (protected + should be 400 once logged in)
POST {{baseUrl}}/apartments
Content-Type: application/json

{
  "address": "Incomplete listing",
  "rent": "not-a-number"
}

### Update an apartment (protected)
PUT {{baseUrl}}/apartments/REPLACE_WITH_REAL_ID
Content-Type: application/json

{
  "address": "123 Main St, Apt 4B",
  "rent": 1400,
  "bedrooms": 2,
  "bathrooms": 1,
  "squareFootage": 850,
  "petsAllowed": true,
  "contactInfo": "landlord@example.com",
  "status": "applied",
  "notes": "Rent negotiated down, application submitted"
}

### Delete an apartment (protected)
DELETE {{baseUrl}}/apartments/REPLACE_WITH_REAL_ID

### ---------------------------------------------------------------

### Get all viewings (public)
GET {{baseUrl}}/viewings

### Get a single viewing by id (public)
GET {{baseUrl}}/viewings/REPLACE_WITH_REAL_ID

### Create a viewing (protected; apartmentId must be a real apartment's _id)
POST {{baseUrl}}/viewings
Content-Type: application/json

{
  "apartmentId": "REPLACE_WITH_REAL_APARTMENT_ID",
  "scheduledDate": "2026-09-25T16:00:00Z",
  "rating": 4,
  "notes": "First viewing, ask about parking"
}

### Create a viewing with a fake apartmentId (protected + should be 400 once logged in)
POST {{baseUrl}}/viewings
Content-Type: application/json

{
  "apartmentId": "507f1f77bcf86cd799439099",
  "scheduledDate": "2026-09-25T16:00:00Z"
}

### Update a viewing (protected)
PUT {{baseUrl}}/viewings/REPLACE_WITH_REAL_VIEWING_ID
Content-Type: application/json

{
  "apartmentId": "REPLACE_WITH_REAL_APARTMENT_ID",
  "scheduledDate": "2026-09-25T16:00:00Z",
  "attended": true,
  "rating": 4,
  "notes": "Nice place, a bit small"
}

### Delete a viewing (protected)
DELETE {{baseUrl}}/viewings/REPLACE_WITH_REAL_VIEWING_ID
